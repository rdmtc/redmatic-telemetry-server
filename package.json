  "private": true,
  "description": "Receives the RedMatic telemetry and serves the RedMatic Usage Statistics page",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdmtc/redmatic-telemetry-server.git"
  },
  "bugs": {
    "url": "https://github.com/rdmtc/redmatic-telemetry-server/issues"
  },
  "homepage": "https://telemetry.redmatic.de",
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "semantic-compare": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
